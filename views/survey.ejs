<%- include('partials/header') %>

  <main>
    <h1>Customer survey</h1>
    <p>Please fill in the form below — it only takes a minute.</p>

<form method="POST" action="/survey_result">
    <!--Details-->
    <h2>Your Details</h2>
    <label for="first_name">First Name:</label>
    <input id="first_name" type="text" name="first_name" required />
    <br />
    <label for="surname">Surname:</label>
    <input id="surname" type="text" name="surname" required />
    <br />
    <label for="email">Email:</label>
    <input id="email" type="email" name="email" required />
    <br /><br />

    <!--Survey Questions-->
    <h2>Survey Questions</h2>

    <!-- Age-->
        <label for="age">How old are you?</label>
        <input id="age" name="age" type="text" />

    <br /><br />


        <!--Drink Category questions -->
          <p>Which of the following drinks categories do you consume?</p>
          <% if (productCategories && productCategories.length) { %>
            <% productCategories.forEach(function(cat, idx) { %>
              <div class="survey-option-row">
                <input id="cat-<%= idx %>" type="radio" name="drink_category" value="<%= cat %>" <%= idx===0? 'checked' : '' %> />
                <label for="cat-<%= idx %>" class="survey-option"><%= cat %></label>
              </div>
            <% }) %>
          <% } %>
          <br /> <br />

        <!-- Student question  -->
          <legend>Student status</legend>
          <div>
            <input id="is_student" name="is_student" type="checkbox" value="yes" />
            <label for="is_student" class="survey-option">Are you a student?</label>
            <br /> <br />

          </div>

      <input type="submit" value="Submit survey" />
    </form>
  </main>

<%- include('partials/footer') %>
